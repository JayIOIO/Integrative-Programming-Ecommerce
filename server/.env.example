# Express API port
PORT=5000

# Local MySQL connection settings
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=ecommerce_db

# Replace this placeholder with a private random secret in server/.env
JWT_SECRET=replace_with_a_long_random_secret

# Comma-separated browser origins permitted to call the API
CORS_ORIGIN=http://localhost:5173
